# Exposes cmake_base_apply_sanitizers.
# Internal per-compiler-family sanitizer flag tables; not exported.

if(NOT CMAKE_BASE_CONFIGS)
	message(FATAL_ERROR "cmake-base: CMAKE_BASE_CONFIGS must be set before including sanitizers.cmake")
endif()

set(_CMAKE_BASE_SANITIZER_KNOWN ASAN UBSAN TSAN)
set(_CMAKE_BASE_WARNED_UNSUPPORTED_SANITIZERS "")

# --- Compiler family + flag table (include time) ---

set(_CMAKE_BASE_SANITIZER_FAMILY "other")
set(_CMAKE_BASE_SANITIZER_ASAN_COMPILE_FLAGS "")
set(_CMAKE_BASE_SANITIZER_ASAN_LINK_FLAGS "")
set(_CMAKE_BASE_SANITIZER_UBSAN_COMPILE_FLAGS "")
set(_CMAKE_BASE_SANITIZER_UBSAN_LINK_FLAGS "")
set(_CMAKE_BASE_SANITIZER_TSAN_COMPILE_FLAGS "")
set(_CMAKE_BASE_SANITIZER_TSAN_LINK_FLAGS "")
set(_CMAKE_BASE_SANITIZER_AUX_COMPILE_FLAGS "")
set(_CMAKE_BASE_SANITIZER_AUX_LINK_FLAGS "")

if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
	set(_CMAKE_BASE_SANITIZER_FAMILY "gnu")
	set(_CMAKE_BASE_SANITIZER_ASAN_COMPILE_FLAGS "-fsanitize=address")
	set(_CMAKE_BASE_SANITIZER_ASAN_LINK_FLAGS "-fsanitize=address")
	set(_CMAKE_BASE_SANITIZER_UBSAN_COMPILE_FLAGS "-fsanitize=undefined")
	set(_CMAKE_BASE_SANITIZER_UBSAN_LINK_FLAGS "-fsanitize=undefined")
	set(_CMAKE_BASE_SANITIZER_TSAN_COMPILE_FLAGS "-fsanitize=thread")
	set(_CMAKE_BASE_SANITIZER_TSAN_LINK_FLAGS "-fsanitize=thread")
	set(_CMAKE_BASE_SANITIZER_AUX_COMPILE_FLAGS "-fno-omit-frame-pointer")
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
	set(_CMAKE_BASE_SANITIZER_FAMILY "clang")
	set(_CMAKE_BASE_SANITIZER_ASAN_COMPILE_FLAGS "-fsanitize=address")
	set(_CMAKE_BASE_SANITIZER_ASAN_LINK_FLAGS "-fsanitize=address")
	set(_CMAKE_BASE_SANITIZER_UBSAN_COMPILE_FLAGS "-fsanitize=undefined")
	set(_CMAKE_BASE_SANITIZER_UBSAN_LINK_FLAGS "-fsanitize=undefined")
	set(_CMAKE_BASE_SANITIZER_TSAN_COMPILE_FLAGS "-fsanitize=thread")
	set(_CMAKE_BASE_SANITIZER_TSAN_LINK_FLAGS "-fsanitize=thread")
	set(_CMAKE_BASE_SANITIZER_AUX_COMPILE_FLAGS "-fno-omit-frame-pointer")
elseif(MSVC)
	set(_CMAKE_BASE_SANITIZER_FAMILY "msvc")
	if(MSVC_VERSION GREATER_EQUAL 1928)
		set(_CMAKE_BASE_SANITIZER_ASAN_COMPILE_FLAGS "/fsanitize=address")
		set(_CMAKE_BASE_SANITIZER_ASAN_LINK_FLAGS "/fsanitize=address")
		set(_CMAKE_BASE_SANITIZER_AUX_LINK_FLAGS "/INCREMENTAL:NO")
	endif()
endif()

# --- Internal helpers ---

function(_cmake_base_sanitizer_compile_flags name out_var)
	if(name STREQUAL "ASAN")
		set("${out_var}" "${_CMAKE_BASE_SANITIZER_ASAN_COMPILE_FLAGS}" PARENT_SCOPE)
	elseif(name STREQUAL "UBSAN")
		set("${out_var}" "${_CMAKE_BASE_SANITIZER_UBSAN_COMPILE_FLAGS}" PARENT_SCOPE)
	elseif(name STREQUAL "TSAN")
		set("${out_var}" "${_CMAKE_BASE_SANITIZER_TSAN_COMPILE_FLAGS}" PARENT_SCOPE)
	else()
		set("${out_var}" "" PARENT_SCOPE)
	endif()
endfunction()

function(_cmake_base_sanitizer_link_flags name out_var)
	if(name STREQUAL "ASAN")
		set("${out_var}" "${_CMAKE_BASE_SANITIZER_ASAN_LINK_FLAGS}" PARENT_SCOPE)
	elseif(name STREQUAL "UBSAN")
		set("${out_var}" "${_CMAKE_BASE_SANITIZER_UBSAN_LINK_FLAGS}" PARENT_SCOPE)
	elseif(name STREQUAL "TSAN")
		set("${out_var}" "${_CMAKE_BASE_SANITIZER_TSAN_LINK_FLAGS}" PARENT_SCOPE)
	else()
		set("${out_var}" "" PARENT_SCOPE)
	endif()
endfunction()

function(_cmake_base_sanitizer_is_supported name out_var)
	_cmake_base_sanitizer_compile_flags("${name}" _compile_flags)
	if(_compile_flags)
		set("${out_var}" TRUE PARENT_SCOPE)
	else()
		set("${out_var}" FALSE PARENT_SCOPE)
	endif()
endfunction()

function(_cmake_base_warn_unsupported_sanitizer name)
	if(name IN_LIST _CMAKE_BASE_WARNED_UNSUPPORTED_SANITIZERS)
		return()
	endif()
	list(APPEND _CMAKE_BASE_WARNED_UNSUPPORTED_SANITIZERS "${name}")
	set(_CMAKE_BASE_WARNED_UNSUPPORTED_SANITIZERS "${_CMAKE_BASE_WARNED_UNSUPPORTED_SANITIZERS}" PARENT_SCOPE)
	message(WARNING "cmake-base: ${CMAKE_CXX_COMPILER_ID} does not support ${name}")
endfunction()

function(_cmake_base_warn_duplicate_sanitizer name)
	message(WARNING "cmake_base_apply_sanitizers: duplicate sanitizer '${name}' in SANITIZERS list; using once")
endfunction()

function(_cmake_base_check_sanitizer_compat sanitizer_list)
	set(_has_asan FALSE)
	set(_has_ubsan FALSE)
	set(_has_tsan FALSE)
	foreach(_san IN LISTS sanitizer_list)
		if(_san STREQUAL "ASAN")
			set(_has_asan TRUE)
		elseif(_san STREQUAL "UBSAN")
			set(_has_ubsan TRUE)
		elseif(_san STREQUAL "TSAN")
			set(_has_tsan TRUE)
		endif()
	endforeach()
	if(_has_asan AND _has_tsan)
		message(FATAL_ERROR "cmake_base_apply_sanitizers: ASAN and TSAN are incompatible")
	endif()
	if(_has_ubsan AND _has_tsan)
		message(FATAL_ERROR "cmake_base_apply_sanitizers: UBSAN and TSAN are incompatible")
	endif()
endfunction()

function(_cmake_base_sanitizer_property_key config out_var)
	set("${out_var}" "CMAKE_BASE_SANITIZERS_${config}" PARENT_SCOPE)
endfunction()

function(_cmake_base_sanitizer_aux_property_key config out_var)
	set("${out_var}" "CMAKE_BASE_SANITIZERS_AUX_${config}" PARENT_SCOPE)
endfunction()

function(_cmake_base_merge_sanitizer_sets old_list new_list out_var)
	set(_merged "${old_list}")
	foreach(_san IN LISTS new_list)
		if(NOT _san IN_LIST _merged)
			list(APPEND _merged "${_san}")
		endif()
	endforeach()
	list(SORT _merged)
	set("${out_var}" "${_merged}" PARENT_SCOPE)
endfunction()

function(_cmake_base_sanitizer_sets_equal left right out_var)
	if("${left}" STREQUAL "${right}")
		set("${out_var}" TRUE PARENT_SCOPE)
	else()
		set("${out_var}" FALSE PARENT_SCOPE)
	endif()
endfunction()

function(_cmake_base_apply_aux_flags_for_config target config sanitizer_list)
	if(NOT sanitizer_list)
		return()
	endif()

	_cmake_base_sanitizer_aux_property_key("${config}" _aux_key)
	get_target_property(_aux_applied "${target}" "${_aux_key}")
	if(_aux_applied)
		return()
	endif()

	set(_apply_aux FALSE)
	if(_CMAKE_BASE_SANITIZER_FAMILY STREQUAL "gnu" OR _CMAKE_BASE_SANITIZER_FAMILY STREQUAL "clang")
		set(_apply_aux TRUE)
	elseif(_CMAKE_BASE_SANITIZER_FAMILY STREQUAL "msvc")
		if("ASAN" IN_LIST sanitizer_list)
			set(_apply_aux TRUE)
		endif()
	endif()

	if(NOT _apply_aux)
		return()
	endif()

	if(_CMAKE_BASE_SANITIZER_AUX_COMPILE_FLAGS)
		target_compile_options("${target}" PRIVATE "$<$<CONFIG:${config}>:${_CMAKE_BASE_SANITIZER_AUX_COMPILE_FLAGS}>")
	endif()
	if(_CMAKE_BASE_SANITIZER_AUX_LINK_FLAGS)
		target_link_options("${target}" PRIVATE "$<$<CONFIG:${config}>:${_CMAKE_BASE_SANITIZER_AUX_LINK_FLAGS}>")
	endif()

	set_target_properties("${target}" PROPERTIES "${_aux_key}" TRUE)
endfunction()

function(_cmake_base_apply_sanitizer_delta_for_config target config delta_list)
	foreach(_san IN LISTS delta_list)
		_cmake_base_sanitizer_compile_flags("${_san}" _compile_flag)
		_cmake_base_sanitizer_link_flags("${_san}" _link_flag)
		if(_compile_flag)
			target_compile_options("${target}" PRIVATE "$<$<CONFIG:${config}>:${_compile_flag}>")
		endif()
		if(_link_flag)
			target_link_options("${target}" PRIVATE "$<$<CONFIG:${config}>:${_link_flag}>")
		endif()
	endforeach()
endfunction()

function(_cmake_base_apply_sanitizers_for_config target config supported_sanitizers)
	if(NOT supported_sanitizers)
		return()
	endif()

	_cmake_base_sanitizer_property_key("${config}" _prop_key)
	get_target_property(_existing "${target}" "${_prop_key}")
	if(_existing STREQUAL "_existing-NOTFOUND")
		set(_existing "")
	endif()
	if(_existing)
		list(SORT _existing)
	endif()

	_cmake_base_merge_sanitizer_sets("${_existing}" "${supported_sanitizers}" _merged)
	_cmake_base_sanitizer_sets_equal("${_merged}" "${_existing}" _unchanged)
	if(_unchanged)
		return()
	endif()

	_cmake_base_check_sanitizer_compat("${_merged}")

	set(_delta "${supported_sanitizers}")
	if(_existing)
		foreach(_san IN LISTS _existing)
			list(REMOVE_ITEM _delta "${_san}")
		endforeach()
	endif()

	if(NOT _existing)
		_cmake_base_apply_aux_flags_for_config("${target}" "${config}" "${_merged}")
	endif()

	if(_delta)
		_cmake_base_apply_sanitizer_delta_for_config("${target}" "${config}" "${_delta}")
	endif()

	set_target_properties("${target}" PROPERTIES "${_prop_key}" "${_merged}")
endfunction()

# --- Public API ---

function(cmake_base_apply_sanitizers target)
	set(_options "")
	set(_one_value "")
	set(_multi_value SANITIZERS CONFIGS)
	cmake_parse_arguments(_ARG "${_options}" "${_one_value}" "${_multi_value}" ${ARGN})

	if(NOT _ARG_SANITIZERS)
		message(FATAL_ERROR "cmake_base_apply_sanitizers: SANITIZERS is required")
	endif()
	if(NOT _ARG_CONFIGS)
		message(FATAL_ERROR "cmake_base_apply_sanitizers: CONFIGS is required")
	endif()
	if(NOT TARGET "${target}")
		message(FATAL_ERROR "cmake_base_apply_sanitizers: target '${target}' does not exist")
	endif()

	set(_deduped_sanitizers "")
	foreach(_san IN LISTS _ARG_SANITIZERS)
		if(_san IN_LIST _deduped_sanitizers)
			_cmake_base_warn_duplicate_sanitizer("${_san}")
			continue()
		endif()
		if(NOT _san IN_LIST _CMAKE_BASE_SANITIZER_KNOWN)
			message(FATAL_ERROR "cmake_base_apply_sanitizers: unknown sanitizer '${_san}'")
		endif()
		list(APPEND _deduped_sanitizers "${_san}")
	endforeach()

	set(_supported_sanitizers "")
	foreach(_san IN LISTS _deduped_sanitizers)
		_cmake_base_sanitizer_is_supported("${_san}" _is_supported)
		if(_is_supported)
			list(APPEND _supported_sanitizers "${_san}")
		else()
			_cmake_base_warn_unsupported_sanitizer("${_san}")
		endif()
	endforeach()

	foreach(_config IN LISTS _ARG_CONFIGS)
		if(NOT _config IN_LIST CMAKE_BASE_CONFIGS)
			message(FATAL_ERROR "cmake_base_apply_sanitizers: unknown config '${_config}'")
		endif()
	endforeach()

	if(_supported_sanitizers)
		_cmake_base_check_sanitizer_compat("${_supported_sanitizers}")
	endif()

	foreach(_config IN LISTS _ARG_CONFIGS)
		_cmake_base_apply_sanitizers_for_config("${target}" "${_config}" "${_supported_sanitizers}")
	endforeach()
endfunction()
